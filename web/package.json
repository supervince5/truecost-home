{
  "name": "truecost-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "benchmark:live": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.benchmark.config.mts benchmarks/live.bench.ts",
    "benchmark:photos": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.benchmark.config.mts benchmarks/photos.bench.ts",
    "benchmark:reliability": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.benchmark.config.mts benchmarks/reliability.bench.ts",
    "benchmark:vision": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.benchmark.config.mts benchmarks/vision-comparison.bench.ts"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
