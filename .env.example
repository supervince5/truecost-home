# Copy to web/.env.local for local development. Never commit real credentials.
# The adapter uses Google's fixed API endpoint; custom provider URLs are not accepted.
GEMMA_API_KEY=
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# Production API is off by default. Enable only behind private Cloud Run IAM
# or equivalent access controls. This flag is not authentication.
ENABLE_ANALYZE_API=false

# Reserved for later persistence/deployment; not consumed yet.
GOOGLE_CLOUD_PROJECT=
UPLOAD_BUCKET=
FIRESTORE_DATABASE_ID=(default)
