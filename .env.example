# Proposed configuration; no application consumes these names yet.
# Keep real credentials in ignored local configuration or Google Secret Manager.
# All model, database and storage configuration below is server-only.
GEMMA_PROVIDER=
GEMMA_MODEL_ID=
GEMMA_API_BASE_URL=
GEMMA_API_KEY=
GOOGLE_CLOUD_PROJECT=
UPLOAD_BUCKET=
FIRESTORE_DATABASE_ID=(default)

# The browser calls same-origin /api routes; no separate backend origin is needed.
# On Cloud Run use the service identity, not committed service-account keys.
